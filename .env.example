DB_PASSWORD=your_db_password_here
CONNECTION_STRING=Server=mysql;Port=3306;Database=hometask;Uid=root;Pwd=your_db_password_here;
JWT_SECRET_KEY=your_jwt_secret_key_needs_32_chars_at_least
VITE_API_BASE_URL=http://localhost:5000

# Credenciais da aplicacao Mercado Pago.
# Obtenha em: Suas integracoes > sua aplicacao > Credenciais
MERCADOPAGO_PUBLIC_KEY=your_mercadopago_public_key
MERCADOPAGO_ACCESS_TOKEN=your_mercadopago_access_token
MERCADOPAGO_APP_ID=your_mercadopago_app_id
MERCADOPAGO_USER_ID=your_mercadopago_user_id

# Conta compradora de teste do Mercado Pago.
# Obtenha em: Suas integracoes > sua aplicacao > Testes > Contas de teste
MERCADOPAGO_TEST_USER=your_mercadopago_test_user
MERCADOPAGO_TEST_PASSWORD=your_mercadopago_test_password
MERCADOPAGO_TEST_VERIFICATION_CODE=your_mercadopago_test_verification_code

# URL publica da API usada pelo Mercado Pago para:
# - webhook: /api/Pagamento/WebhookMercadoPago
# - retorno do checkout: /api/Pagamento/RetornoCheckout/{agendamentoId}
# Em desenvolvimento local, troque para a URL publica do seu tunel apontando para http://localhost:5000
# Exemplo: https://seu-tunel.trycloudflare.com
MERCADOPAGO_API_BASE_URL=http://localhost:5000

# URL local do frontend usada pela API para redirecionar o navegador depois do checkout.
MERCADOPAGO_FRONTEND_BASE_URL=http://localhost:8080

# Caminho publico do webhook do Mercado Pago.
MERCADOPAGO_WEBHOOK_PATH=/api/Pagamento/WebhookMercadoPago
