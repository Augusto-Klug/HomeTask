@page
@model HomeTask.WebApi.Pages.Cadastro.SucessoModel
@{
    ViewData["Title"] = "Cadastro Realizado - HomeTask";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow-sm">
                <div class="card-body p-5">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
                    <h2 class="mt-4">Cadastro Realizado!</h2>
                    <p class="text-muted">
                        Sua conta foi criada com sucesso. Agora você pode acessar todos os recursos do HomeTask.
                    </p>
                    <div class="d-grid gap-2 mt-4">
                        <a href="/Login" class="btn btn-primary btn-lg">Fazer Login</a>
                        <a href="/" class="btn btn-outline-secondary">Voltar para Home</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
