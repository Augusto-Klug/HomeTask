@page
@model HomeTask.Web.Pages.Agendamento.NovoModel
@{
    ViewData["Title"] = "Novo Agendamento - HomeTask";
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item"><a href="/Servicos/Buscar">Buscar Serviços</a></li>
            <li class="breadcrumb-item active">Novo Agendamento</li>
        </ol>
    </nav>

    <div class="row g-4 justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Confirmar Agendamento</h4>
                </div>
                <div class="card-body">
                    <!-- Resumo do Serviço -->
                    <div class="alert alert-light border mb-4">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <strong>@Model.Servico.Titulo</strong>
                                <div class="text-muted small">Prestador: @Model.Servico.PrestadorNome</div>
                            </div>
                            <span class="text-primary fw-bold fs-5">R$ @Model.Servico.PrecoBase.ToString("N2") / @Model.Servico.UnidadeCobranca</span>
                        </div>
                    </div>

                    <form method="post">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="Input.ServicoOferecidoId" />
                        <input type="hidden" asp-for="Input.PrestadorId" />

                        <div class="mb-3">
                            <label asp-for="Input.DataHoraAgendada" class="form-label">Data e Hora</label>
                            <input asp-for="Input.DataHoraAgendada" type="datetime-local" class="form-control" />
                            <span asp-validation-for="Input.DataHoraAgendada" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.EnderecoServico" class="form-label">Endereço do Serviço</label>
                            <input asp-for="Input.EnderecoServico" class="form-control" placeholder="Rua, número, complemento" />
                            <span asp-validation-for="Input.EnderecoServico" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Observacoes" class="form-label">Observações</label>
                            <textarea asp-for="Input.Observacoes" class="form-control" rows="3"
                                      placeholder="Alguma instrução especial para o prestador?"></textarea>
                            <span asp-validation-for="Input.Observacoes" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-calendar-check me-1"></i> Confirmar Agendamento
                            </button>
                            <a href="/Servicos/Detalhes/@Model.Servico.Id" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
