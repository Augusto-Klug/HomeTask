@page
@model HomeTask.Web.Pages.Servicos.BuscarModel
@{
    ViewData["Title"] = "Buscar Serviços - HomeTask";
}

<div class="container py-4">
    <h1 class="mb-4">Buscar Serviços</h1>
    
    <!-- Filtros de Busca -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label">Categoria</label>
                        <select asp-for="Filtro.Categoria" class="form-select" asp-items="Model.Categorias">
                            <option value="">Todas as categorias</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Cidade</label>
                        <input asp-for="Filtro.Cidade" class="form-control" placeholder="Digite a cidade">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Preço Máximo</label>
                        <input asp-for="Filtro.PrecoMaximo" type="number" class="form-control" placeholder="R$">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Avaliação Mínima</label>
                        <select asp-for="Filtro.AvaliacaoMinima" class="form-select">
                            <option value="">Qualquer</option>
                            <option value="3">3+ estrelas</option>
                            <option value="4">4+ estrelas</option>
                            <option value="5">5 estrelas</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search"></i> Buscar
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Resultados -->
    @if (Model.Servicos.Any())
    {
        <div class="row g-4">
            @foreach (var servico in Model.Servicos)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                                    <span class="fs-5">@servico.PrestadorNome[0]</span>
                                </div>
                                <div>
                                    <h6 class="mb-0">@servico.PrestadorNome</h6>
                                    <small class="text-muted">@servico.Cidade</small>
                                </div>
                            </div>
                            
                            <h5 class="card-title">@servico.Titulo</h5>
                            <span class="badge bg-secondary mb-2">@servico.CategoriaNome</span>
                            
                            <p class="card-text text-muted small">@servico.Descricao</p>
                            
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <span class="text-warning">
                                        @for (int i = 0; i < 5; i++)
                                        {
                                            if (i < (int)servico.MediaAvaliacoes)
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star"></i>
                                            }
                                        }
                                    </span>
                                    <small class="text-muted">(@servico.TotalAvaliacoes)</small>
                                </div>
                                <strong class="text-primary fs-5">R$ @servico.PrecoBase.ToString("N2")</strong>
                            </div>
                            
                            <a href="/Servicos/Detalhes/@servico.Id" class="btn btn-outline-primary w-100">
                                Ver Detalhes
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-search fs-1 text-muted"></i>
            <h4 class="mt-3">Nenhum serviço encontrado</h4>
            <p class="text-muted">Tente ajustar os filtros de busca ou buscar em outra categoria.</p>
        </div>
    }
</div>
