@page
@model HomeTask.Web.Pages.Login.IndexModel
@{
    ViewData["Title"] = "Login - HomeTask";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Entrar no HomeTask</h3>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.ErroLogin))
                    {
                        <div class="alert alert-danger">@Model.ErroLogin</div>
                    }

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label">E-mail</label>
                            <input asp-for="Input.Email" class="form-control" type="email" placeholder="seu@email.com" autofocus>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Senha" class="form-label">Senha</label>
                            <input asp-for="Input.Senha" class="form-control" type="password" placeholder="Sua senha">
                            <span asp-validation-for="Input.Senha" class="text-danger"></span>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">Entrar</button>
                        </div>
                    </form>
                </div>
                <div class="card-footer text-center">
                    Não tem conta? <a href="/Cadastro">Cadastre-se</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
